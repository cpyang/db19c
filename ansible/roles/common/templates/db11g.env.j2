# Source this to work in the 11.2.0.4 home: . ~/db11g.env
# (GI/srvctl stay 19c; only ORACLE_HOME/SID/PATH switch)
export ORACLE_BASE={{ oracle_base }}
export ORACLE_HOME={{ oracle11_home }}
unset ORACLE_SID          # db11 is srvctl-managed; set only for local sqlplus:
# export ORACLE_SID={{ db11_sid }}
export PATH=$ORACLE_HOME/bin:$PATH
export LD_LIBRARY_PATH=$ORACLE_HOME/lib:/usr/lib
