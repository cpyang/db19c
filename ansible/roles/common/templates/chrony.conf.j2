# Managed by Ansible — chrony.conf (lab, EL9)
# EL9 has no ntpd; CVU's PRVF-5408 needs BOTH nodes on the same explicit
# server — pool.* randomizes upstreams per node (db11g di-2026-10-23).
{% for server in ntp_servers %}
server {{ server }} iburst
{% endfor %}
driftfile /var/lib/chrony/drift
makestep 1.0 3
rtcsync
local stratum 10
logdir /var/log/chrony
