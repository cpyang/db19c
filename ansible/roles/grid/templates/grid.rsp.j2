# 19c GI (CRS_CONFIG) response — rendered by the grid role.
# Keys cross-checked against oracle_dr_on_aws/tests/response_files/grid_install_rac1.rsp
# (a proven-working 19.31 gridSetup on this lab family).
oracle.install.responseFileVersion=/oracle/install/rspfmt_crsinstall_response_schema_v19.0.0
INVENTORY_LOCATION={{ ora_inventory }}
oracle.install.option=CRS_CONFIG
ORACLE_BASE={{ grid_base }}
ORACLE_HOME={{ grid_home }}

# ASM privileges (fixed GIDs from roles/common)
oracle.install.asm.OSDBA={{ oracle_asm_dba_group }}
oracle.install.asm.OSOPER={{ oracle_asm_oper_group }}
oracle.install.asm.OSASM={{ oracle_asm_group }}

# SCAN via local dnsmasq (see roles/common DNS block)
oracle.install.crs.config.scanType=LOCAL_SCAN
oracle.install.crs.config.gpnp.scanName={{ scan_name }}
oracle.install.crs.config.gpnp.scanPort={{ scan_port }}

oracle.install.crs.config.ClusterConfiguration=STANDALONE
oracle.install.crs.config.clusterName={{ cluster_name }}
oracle.install.crs.config.gpnp.configureGNS=false
# VIPs STATIC via /etc/hosts — db11g hit PRKC-1168 with AUTO on 11g's
# root.sh; the tests lab used AUTO+hosts and lived, but static is the
# smaller failure surface (README troubleshooting line).
oracle.install.crs.config.autoConfigureClusterNodeVIP=false
oracle.install.crs.config.clusterNodes={% for n in groups['rac'] %}{{ hostvars[n].short_name }}:{{ hostvars[n].short_name }}-vip{% if not loop.last %},{% endif %}{% endfor %}

# NIC roles resolved BY ADDRESS at runtime (never ethX — db11g lesson).
# :1 = public, :5 = cluster interconnect (ASM+private).
oracle.install.crs.config.networkInterfaceList={{ pub_iface }}:{{ network_public_subnet }}:1,{{ priv_iface }}:{{ network_private_subnet }}:5

# No GIMR (lab disk budget), no IPMI, plain ASM (NOT ASMFD: 11.2 homes
# cannot use ASMFD — Doc 2341119.1 — and 11g is part of this cluster).
oracle.install.crs.configureGIMR=false
oracle.install.asm.configureGIMRDataDG=false
oracle.install.crs.config.storageOption=FLEX_ASM_STORAGE
oracle.install.crs.config.useIPMI=false

# OCR + voting on the CRS group, EXTERNAL (single 12G disk, lab).
oracle.install.asm.SYSASMPassword={{ sys_password }}
oracle.install.asm.monitorPassword={{ asm_monitor_password }}
oracle.install.asm.diskGroup.name={{ asm_diskgroup_crs }}
oracle.install.asm.diskGroup.redundancy=EXTERNAL
oracle.install.asm.diskGroup.AUSize=4
oracle.install.asm.diskGroup.disks=/dev/oracleasm/disks/{{ asm_diskgroup_crs }}
oracle.install.asm.diskGroup.diskDiscoveryString={{ asm_diskstring }}

oracle.install.config.managementOption=NONE
oracle.install.crs.rootconfig.executeRootScript=false
