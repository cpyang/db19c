# db19c RAC inventory (GI 19c + DB 19c + DB 11.2.0.4)
# Hostnames are FQDNs on purpose: CVU rejects non-FQDN nodes (PRVF-4167)
# and the response files register nodes by the name `hostname` prints.
# ansible_host = the VBox host-only IP; the Vagrant machine key authenticates.

[rac]
db19c-rac1.db19c.lab ansible_host=192.168.96.11 short_name=db19c-rac1 node_num=1 public_ip=192.168.96.11 private_ip=10.96.96.11 vip=192.168.96.101 ansible_ssh_private_key_file=../.vagrant/machines/db19c-rac1/virtualbox/private_key
db19c-rac2.db19c.lab ansible_host=192.168.96.12 short_name=db19c-rac2 node_num=2 public_ip=192.168.96.12 private_ip=10.96.96.12 vip=192.168.96.102 ansible_ssh_private_key_file=../.vagrant/machines/db19c-rac2/virtualbox/private_key

[rac:vars]
ansible_user=vagrant
ansible_become=yes
ansible_become_method=sudo

[all:vars]
domain_name=db19c.lab
network_public=192.168.96
network_private=10.96.96
scan_name=db19c-scan
scan_ip=192.168.96.100
cluster_name=db19c-cluster
